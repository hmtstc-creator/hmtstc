# HMTSTC backend environment example — commit-safe placeholder only.
# Copy to backend/.env on VPS/local runtime and fill real values there.
# Do not commit backend/.env.

HMTSTC_ENV=production
HMTSTC_SECRET_KEY=replace_with_vps_only_secret
HMTSTC_OWNER_USERNAME=ahmet
HMTSTC_OWNER_PASSWORD=change_on_first_login
HMTSTC_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# User/exchange credentials are stored through the app credential layer, not in this file.
HMTSTC_BINANCE_API_KEY=replace_me_for_local_readonly_only
HMTSTC_BINANCE_API_SECRET=replace_me_for_local_readonly_only

# Safety defaults: live submit/close stays OFF unless explicitly enabled with owner approval/session guard.
HMTSTC_REAL_TRADING_ENABLED=false
HMTSTC_REAL_TRADE_ENABLED=false
HMTSTC_ENABLE_REAL_SUBMIT=false
HMTSTC_ENABLE_REAL_CLOSE=false
HMTSTC_ENABLE_EMERGENCY_CLOSE=false
HMTSTC_AUTO_SCALE_ENABLED=false
HMTSTC_AUTO_APPLY_ENABLED=false
HMTSTC_AUTO_CLOSE_ENABLED=false
HMTSTC_DISABLE_RUNTIME_SCHEDULER=false
